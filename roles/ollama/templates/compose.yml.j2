services:
  ollama:
    image: {{ ollama_image | to_json }}
    container_name: ollama
    restart: unless-stopped
    ports:
      - {{ (ollama_bind_address ~ ':11434:11434') | to_json }}
    volumes:
      - ollama_data:/root/.ollama
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
{% if ollama_enable_gpu | bool %}
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
{% endif %}

volumes:
  ollama_data:
    name: {{ ollama_volume_name | to_json }}
